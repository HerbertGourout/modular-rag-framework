{
  "$defs": {
    "ComponentConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "title": "ComponentConfig",
      "type": "object"
    },
    "EngineSelection": {
      "additionalProperties": false,
      "description": "Which `DocumentEngine` adapter (Lot 7/8) wires this pipeline. Optional \u2014\na manifest without this section defaults to the native adapter\n(`RAGEngine`), preserving v1 behavior exactly. Populating it is one of\nthe markers of a v2 manifest (`app/manifest_migration.py`).",
      "properties": {
        "adapter": {
          "default": "native",
          "title": "Adapter",
          "type": "string"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        }
      },
      "title": "EngineSelection",
      "type": "object"
    },
    "GovernanceSection": {
      "additionalProperties": false,
      "description": "Governance components activated by the application composition root.\n\n`tenant_enforcement` is a deliberate, explicit governance *intent* flag \u2014\nseparate from `tenant_policy` (which component implements it). Defaulting\nto `False` makes \"no tenant isolation\" a visible, auditable fact on every\nmigrated/loaded manifest instead of a silent absence (ADR-0007 \u00a73: \"a\ndeclared manifest section that cannot be activated must fail validation\").\n`tenant_enforcement=True` with `tenant_policy=None` is a validation error\n(see `app/config_resolution.py::validate_capabilities`), not a silent\nno-op.",
      "properties": {
        "tenant_enforcement": {
          "default": false,
          "title": "Tenant Enforcement",
          "type": "boolean"
        },
        "tenant_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_engine": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "redactor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_queue": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audit_sink": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "GovernanceSection",
      "type": "object"
    },
    "LifecycleSection": {
      "additionalProperties": false,
      "description": "Document identity, idempotency and deletion ledger.",
      "properties": {
        "ledger": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "LifecycleSection",
      "type": "object"
    },
    "ObservabilitySection": {
      "additionalProperties": false,
      "description": "Telemetry component selected for runtime traces and metrics.",
      "properties": {
        "telemetry": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ObservabilitySection",
      "type": "object"
    },
    "QualitySection": {
      "additionalProperties": false,
      "description": "Evaluation profile and an optional wired quality gate.",
      "properties": {
        "eval_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Profile"
        },
        "gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "QualitySection",
      "type": "object"
    }
  },
  "additionalProperties": false,
