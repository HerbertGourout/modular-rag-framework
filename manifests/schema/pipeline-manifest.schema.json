    "governance": {
      "anyOf": [
        {
          "$ref": "#/$defs/GovernanceSection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualitySection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
