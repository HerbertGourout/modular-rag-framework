    "evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComponentConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "engine": {
      "anyOf": [
        {
          "$ref": "#/$defs/EngineSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
