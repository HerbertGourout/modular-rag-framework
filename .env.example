# .env.example
#
# Environment variables for Modular RAG Framework development.
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (gitignored)
# 2. Replace placeholders with your actual values
# 3. NEVER commit .env to git (includes secrets)
# 4. Load in your shell: source .env
#
# For CI/CD: Use GitLab CI/CD secrets instead
# (Settings → CI/CD → Variables)
#

---
## REQUIRED FOR DEVELOPMENT
---

# OpenAI API key
# Get from: https://platform.openai.com/account/api-keys
# Required for: LLM generation, embeddings
MRAG_OPENAI_API_KEY=sk-your-key-here-replace-me

# Qdrant vector store
# URL to Qdrant instance (default: local)
# Required for: vector storage, retrieval
MRAG_QDRANT_URL=http://localhost:6333

# Qdrant connection timeout (seconds)
# Optional, default: 30
MRAG_QDRANT_TIMEOUT=30

---
## OPTIONAL FOR TESTING
---

# HuggingFace API token
# Get from: https://huggingface.co/settings/tokens
# Optional for: gated model access, model uploads
# MRAG_HF_TOKEN=hf_your-token-here

# Anthropic API key (alternative to OpenAI)
# Get from: https://console.anthropic.com/
# Optional for: Claude models (V2+ feature)
# MRAG_ANTHROPIC_API_KEY=sk-ant-your-key-here

---
## LOGGING & DEBUGGING
---

# Logging level (DEBUG, INFO, WARNING, ERROR)
# Optional, default: INFO
MRAG_LOG_LEVEL=INFO

# Environment identifier (development, staging, production)
# Optional, default: development
MRAG_ENVIRONMENT=development

---
## TESTING ONLY
---

# Enable test mode (skips certain validations)
# Optional, default: false
MRAG_TEST_MODE=false

# Test API key (for unit tests, not real API)
# Optional, no production impact
# MRAG_TEST_API_KEY=sk-test-key-for-unit-tests-only

---
## SECURITY GUIDELINES
---

# ⚠️ NEVER:
# - Commit .env to git (use .env.example as template)
# - Hardcode secrets in Python code
# - Log full API keys or tokens
# - Share .env files in chat or emails
#
# ✅ ALWAYS:
# - Load from .env with: python-dotenv or manual source
# - Use partial logging: logger.info(f"key={api_key[:6]}...")
# - Rotate keys regularly
# - Use separate keys for dev/staging/production
#
# If a key is leaked:
# 1. Revoke immediately (API provider dashboard)
# 2. Generate new key
# 3. Update .env locally
# 4. Notify team in Slack/Teams
# 5. Check audit logs for misuse
#

---
## QUICK START
---

# Bash/Zsh (Linux/macOS):
#   cp .env.example .env
#   edit .env (add your keys)
#   set -o allexport
#   source .env
#   set +o allexport

